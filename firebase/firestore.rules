rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public leaderboard: anyone may read; anyone may add ONE validated row; nothing may be changed or deleted.
    match /{col}/{id} {
      // col is 'scores' (live) or 'scores_test' (harness); identical validation.
      allow read: if col in ['scores', 'scores_test'];
      allow create: if col in ['scores', 'scores_test']
        && request.resource.data.keys().hasOnly(['name', 'score', 'wave', 'v'])
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Z0-9]{1,3}$')
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 2000000
        && request.resource.data.wave is int
        && request.resource.data.wave >= 1 && request.resource.data.wave <= 200
        && request.resource.data.v is int;
      allow update, delete: if false;
    }
  }
}
